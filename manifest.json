{
  "manifest_version": 3,
  "name": "vivo 广告计划助手",
  "version": "0.3.12",
  "description": "vivo 新版批量广告计划创建助手：每个计划独立流量及本地素材，共享广告参数，逐个提交并关闭。",
  "permissions": ["contextMenus", "storage", "tabs", "debugger", "webNavigation"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://ad.vivo.com.cn/*"],
      "js": ["link-check.js", "media-store.js", "content.js", "workflow.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://adcc.vivo.com.cn/material-center-new*"],
      "js": ["material-frame.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.css"],
      "matches": ["https://ad.vivo.com.cn/*"]
    }
  ]
}
